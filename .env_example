# ============================================================================
# ADNI Knowledge Graph — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to Git — it's already in .gitignore.
#
# How to get these keys:
#   BioPortal  → https://bioportal.bioontology.org/accounts/new
#                Log in → Account page → API key displayed
#   WHO ICD    → https://icd.who.int/icdapi/Account/Register
#                Log in → "View API access key" → client_id + client_secret
# ============================================================================

# --- Database Credentials ---
NEO4J_PASSWORD=your_neo4j_password
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# --- BioPortal REST API (SNOMED-CT, LOINC, UBERON lookups) ---
BIOPORTAL_API_KEY=your_bioportal_api_key_here

# --- WHO ICD REST API (ICD-10/11 disease classification) ---
WHO_ICD_CLIENT_ID=your_who_icd_client_id_here
WHO_ICD_CLIENT_SECRET=your_who_icd_client_secret_here
