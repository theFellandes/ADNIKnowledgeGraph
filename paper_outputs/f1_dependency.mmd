%% F1 — MAKO functional dependency diagram (post-Step-35)
%% The cross-vocabulary AlzKB alignment sits at the centre.
%% The four methodological steps and the Gene Ontology pass feed it; the
%% comparative benchmark on a second cohort is future work.
flowchart LR
    subgraph Steps["Methodological Steps"]
        A["Step A<br/>Three-axis ontology selection"]
        B["Step B<br/>In-place semantic migration"]
        C["Step C<br/>Column-to-concept mapping"]
        D["Step D<br/>Relation normalisation"]
    end

    HUB[["Cross-vocabulary alignment<br/>(MAKO ↔ AlzKB)"]]
    BENCH(["Comparative benchmark<br/>(future work)"])
    GO(["Gene Ontology integration<br/>(Step 35)"]):::added

    A --> HUB
    B --> HUB
    C --> HUB
    D --> HUB
    GO --> HUB
    HUB --> BENCH

    classDef added fill:#dcfce7,stroke:#16a34a,color:#14532d;
    classDef future fill:#fef3c7,stroke:#b8b90c,color:#3f3f00;
    classDef hub fill:#184a7c,stroke:#0f1d3a,color:#ffffff;
    class HUB hub
    class BENCH future
